# NextAuth (Auth.js)
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Publiczny adres aplikacji (Open Graph / share)
# Produkcja: https://twoja-domena.pl
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas lub lokalny MongoDB
# Przykład Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/valora?retryWrites=true&w=majority
MONGODB_URI=

# Opcjonalnie: własne serwery DNS (domyślnie 8.8.8.8,1.1.1.1 — omija problem Dockera na Windows)
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
